#!/usr/bin/env python3
"""离线准备 TinyWarp GitHub Release 文件；不上传、不推送、不更换应用。"""
import argparse
import json
import mmap
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

from tinywarp_version import bundle_version

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("app", type=Path)
parser.add_argument("--output", type=Path, required=True, help="不存在的输出目录")
parser.add_argument("--key", type=Path, default=Path.home() / "Library/Application Support/TinyWarpRelease/update-signing")
args = parser.parse_args()
os.umask(0o077)
repo = Path(__file__).resolve().parent.parent
app = args.app.resolve(strict=True)
try:
    version = bundle_version(app)
    if "-dev." in version:
        parser.error("开发包仅用于本机验证，不作为公开 Release")
except ValueError as error:
    parser.error(str(error))
key = args.key.expanduser()
metadata = key.lstat()
if key.is_symlink() or metadata.st_uid != os.getuid() or metadata.st_mode & 0o077:
    parser.error("签名私钥必须属于当前用户、不是符号链接且仅本人可访问")
public_key = (repo / "resources/tinywarp-updates.pub").read_text().strip()
actual_key = subprocess.check_output(["/usr/bin/ssh-keygen", "-y", "-f", str(key)], text=True).strip()
if actual_key.split()[:2] != public_key.split()[:2]:
    parser.error("签名密钥与应用内置公钥不匹配")
with (app / "Contents/MacOS/warp-oss").open("rb") as executable:
    with mmap.mmap(executable.fileno(), 0, access=mmap.ACCESS_READ) as binary:
        if binary.find(public_key.encode()) < 0:
            parser.error("候选二进制未包含当前发布公钥，请重新构建 U3 应用")
if args.output.exists():
    parser.error("输出目录已存在，不覆盖既有发布文件")
with tempfile.TemporaryDirectory(prefix="tinywarp-release-") as temporary:
    temporary = Path(temporary)
    subprocess.run([str(repo / "script/tinywarp-stage-update"), str(app), "--data-dir", str(temporary / "state")], check=True, capture_output=True)
    inbox = temporary / "state/tinywarp-updates/inbox"
    payload = (inbox / "latest.json").read_bytes()
    manifest = json.loads(payload)
    arch = manifest["architecture"]
    subprocess.run(["/usr/bin/lipo", str(app / "Contents/MacOS/warp-oss"), "-verify_arch", "arm64" if arch == "aarch64" else "x86_64"], check=True, capture_output=True)
    files = temporary / "files"
    files.mkdir()
    manifest_path = files / f"tinywarp-update-{arch}.json"
    manifest_path.write_bytes(payload)
    shutil.copyfile(inbox / "update.zip", files / f"TinyWarp-{arch}.zip")
    subprocess.run(["/usr/bin/ssh-keygen", "-Y", "sign", "-f", str(key), "-n", "tinywarp-updates", str(manifest_path)], check=True, capture_output=True)
    allowed = temporary / "allowed-signers"
    allowed.write_text(f'tinywarp namespaces="tinywarp-updates" {public_key}\n')
    subprocess.run(["/usr/bin/ssh-keygen", "-Y", "verify", "-f", str(allowed), "-I", "tinywarp", "-n", "tinywarp-updates", "-s", str(manifest_path) + ".sig"], input=payload, check=True, capture_output=True)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(files, args.output)
print(json.dumps({"version": manifest["version"], "sha256": manifest["sha256"], "architecture": arch, "files": sorted(p.name for p in args.output.iterdir()), "uploaded": False}, ensure_ascii=False))
