#!/usr/bin/env python3
"""将已构建的 TinyWarp 本地包投递到更新收件箱；不会替换应用或修改用户配置。"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

from tinywarp_version import bundle_version

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('app', type=Path)
parser.add_argument('--data-dir', type=Path, required=True, help='目标实例的独立 Application Support 目录')
args = parser.parse_args()
app = args.app.resolve(strict=True)
try:
    version = bundle_version(app)
except ValueError as error:
    parser.error(str(error))
subprocess.run(['/usr/bin/codesign', '--verify', '--deep', '--strict', str(app)], check=True)
root = args.data_dir.resolve() / 'tinywarp-updates'
root.mkdir(mode=0o700, parents=True, exist_ok=True)
assert not root.is_symlink() and root.stat().st_uid == os.getuid() and root.stat().st_mode & 0o077 == 0
with tempfile.TemporaryDirectory(prefix='prepare-', dir=root) as temp:
    temp = Path(temp)
    shutil.copytree(app, temp / 'TinyWarp.app', symlinks=True)
    archive = temp / 'update.zip'
    subprocess.run(['/usr/bin/ditto', '-c', '-k', '--sequesterRsrc', '--keepParent', str(temp / 'TinyWarp.app'), str(archive)], check=True)
    shutil.rmtree(temp / "TinyWarp.app")
    archive.chmod(0o600)
    manifest = temp / 'latest.json'
    manifest.write_text(json.dumps(dict(version=version, sha256=hashlib.file_digest(archive.open('rb'), 'sha256').hexdigest(), architecture=os.uname().machine.replace('arm64', 'aarch64'))))
    manifest.chmod(0o600)
    # 保留旧 inbox；正在读取它的应用会校验版本和归档哈希，不会使用混合内容。
    inbox = root / 'inbox'
    previous = root / ('inbox-previous-' + str(os.getpid()))
    if inbox.exists():
        inbox.rename(previous)
    try:
        temp.rename(inbox)
    except BaseException:
        if previous.exists(): previous.rename(inbox)
        raise
print(f'已暂存 {version}；在目标 TinyWarp 中检查更新，再选择重启更新。')
